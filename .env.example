# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PINECONE_API_KEY: Required for Pinecone vector database.
PINECONE_API_KEY="MY_PINECONE_API_KEY"

# PINECONE_INDEX: The name of your Pinecone index.
PINECONE_INDEX="MY_PINECONE_INDEX"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EVOLUTION_API_URL: Base URL of your Evolution API instance (e.g. https://evolution.myhost.com)
EVOLUTION_API_URL=
# EVOLUTION_API_KEY: Global API Token for your Evolution API instance (security key)
EVOLUTION_API_KEY=

# WASENDER_API_KEY: Bearer token for WaSender API (WhatsApp integration partner)
WASENDER_API_KEY="your_bearer_token"
# WASENDER_PERSONAL_ACCESS_TOKEN: Personal access token used for administrative tasks, like creating new WhatsApp sessions
WASENDER_PERSONAL_ACCESS_TOKEN="your_personal_access_token"
# WEBHOOK_SECRET: Secret phrase added to request headers x-webhook-signature for validating incoming WaSender callback requests
WEBHOOK_SECRET="your_webhook_secret"
# SESSION_ID: Session ID of WaSender WhatsApp active profile
SESSION_ID="your_session_id"

